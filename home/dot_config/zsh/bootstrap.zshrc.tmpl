#!/usr/bin/env zsh
## ---- Bootstrapping functions ---- ###
source_file() {
  [ -f "$1" ] && source "$1"
}

## ---- Boot SSH Agent ---- ##
# Only when no agent is already provided (launchd, GNOME Keyring, 1Password),
# otherwise every new shell spawns another agent and shadows the system one.
if [ -z "$SSH_AUTH_SOCK" ] && command -v ssh-agent > /dev/null; then
  eval "$(ssh-agent)" > /dev/null
fi

## ---- home bin path ---- ##
export PATH="$HOME/.local/bin:$PATH"

## ---- Homebrew PATH ---- ##
eval "$({{.chezmoi.config.env.BREWBIN}} shellenv)"

## ---- Antidote ---- ##
if [ -f "${ZDOTDIR:-~}/.antidote/antidote.zsh" ]; then
  source "${ZDOTDIR:-~}/.antidote/antidote.zsh"
  antidote load
elif [ -f "$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh" ]; then
  source "$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh"
  antidote load
fi

## ---- Starship ---- ##
if command -v starship > /dev/null; then
  export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
  eval "$(starship init zsh)"
fi

## ---- atuin - shell history ---- ##
if command -v atuin > /dev/null; then
  eval "$(atuin init zsh)"
fi

## ---- Zoxide (better cd) ---- ##
if command -v zoxide > /dev/null; then
  eval "$(zoxide init zsh)"
fi

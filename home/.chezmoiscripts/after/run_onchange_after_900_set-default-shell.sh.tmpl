#!/usr/bin/env bash
echo "⭐️ Running after 900 set-default-shell"

DEFAULT_SHELL="{{ .hostData.default.defaultShell }}"
SHELL_PATH="$($BREWBIN --prefix)/bin/${DEFAULT_SHELL}"

if [ ! -x "$SHELL_PATH" ]; then
  echo "Shell not found at $SHELL_PATH — skipping (is brew installed?)"
  exit 0
fi

# Check if default shell is already correct — avoids unnecessary sudo prompts
CURRENT_SHELL=""
if command -v getent > /dev/null 2>&1; then
  CURRENT_SHELL="$(getent passwd "$(whoami)" | cut -d: -f7)"
elif command -v dscl > /dev/null 2>&1; then
  CURRENT_SHELL="$(dscl . -read ~/ UserShell 2>/dev/null | awk '{print $2}')"
fi

if [ "$CURRENT_SHELL" = "$SHELL_PATH" ]; then
  echo "Default shell already $SHELL_PATH, skipping"
  exit 0
fi

# Add brew-managed shell to /etc/shells if not already listed
if ! grep -qF "$SHELL_PATH" /etc/shells 2>/dev/null; then
  echo "Adding $SHELL_PATH to /etc/shells"
  echo "$SHELL_PATH" | sudo tee -a /etc/shells > /dev/null
fi

# Set default shell — chsh works on macOS and standard Linux
# usermod is the fallback for atomic distros where chsh may be unavailable
if command -v chsh > /dev/null 2>&1; then
  sudo chsh -s "$SHELL_PATH" "$(whoami)" || echo "chsh failed — set shell manually: chsh -s $SHELL_PATH"
elif command -v usermod > /dev/null 2>&1; then
  sudo usermod -s "$SHELL_PATH" "$(whoami)" || echo "usermod failed — set shell manually"
else
  echo "Cannot set default shell — neither chsh nor usermod found. Run manually: chsh -s $SHELL_PATH"
fi

#!/usr/bin/env bash

echo "⭐️ Running before 006 apt-packages"

# Run privileged commands directly when already root (containers, CI, initial
# provisioning); minimal images such as ubuntu:26.04 ship no sudo at all.
SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  SUDO="sudo"
fi

if ! command -v apt-get > /dev/null 2>&1; then
  echo "📝 No apt-get on system, skipping"
  exit 0
fi

{{- $packages := list }}
{{- if hasKey .hostData.default.packages "apt" }}
{{-   $packages = .hostData.default.packages.apt }}
{{- end }}

{{- if not $packages }}
echo "📝 No apt packages defined, skipping"
exit 0
{{- end }}

# Only install what is missing — a no-op apply must never prompt for sudo,
# and skipping the install also lets us skip the apt-get update it needs.
PACKAGES_TO_INSTALL=()
{{- range $packages }}
if ! dpkg-query -W -f='${Status}' "{{ . }}" 2> /dev/null | grep -q "^install ok installed$"; then
  PACKAGES_TO_INSTALL+=("{{ . }}")
fi
{{- end }}

if [ ${#PACKAGES_TO_INSTALL[@]} -eq 0 ]; then
  echo "📝 All apt packages already installed"
  exit 0
fi

echo "Installing: ${PACKAGES_TO_INSTALL[*]}"
$SUDO apt-get update
$SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y "${PACKAGES_TO_INSTALL[@]}"
